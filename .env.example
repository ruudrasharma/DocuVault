# DocuVault — Environment Variables Template
# Copy this file to .env and fill in your values:
#   cp .env.example .env

# Flask secret key — generate with: python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=your-very-secret-key-here

# Flask environment (development | production)
FLASK_ENV=production

# Port to run on (default: 5000)
PORT=5000

# Optional: Set to 1 to enable Flask debug mode (NEVER in production!)
# FLASK_DEBUG=0
